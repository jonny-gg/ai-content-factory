{
  "name": "ai-content-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx tests/*.test.ts",
    "story": "npx tsx src/cli/story.ts",
    "short-drama": "npx tsx src/cli/short-drama.ts",
    "story:batch": "npx tsx scripts/story-batch.ts",
    "story:weekly": "npx tsx scripts/story-weekly.ts",
    "story:weekly:matrix": "npx tsx scripts/story-weekly-matrix.ts",
    "chapter": "npx tsx src/cli/chapter.ts",
    "chapter:full": "npx tsx src/cli/chapter-full.ts",
    "chapter:batch": "npx tsx src/cli/chapter-batch.ts",
    "assets": "npx tsx src/cli/assets.ts",
    "render": "npx tsx src/cli/render.ts",
    "full": "npx tsx src/cli/full-pipeline.ts",
    "delivery": "npx tsx src/cli/delivery-export.ts",
    "daily": "node scripts/daily-job.js",
    "ops-console": "npx tsx src/ops-console/cli.ts",
    "topics:pick": "npx tsx scripts/topic-picker.ts",
    "topics:monetize": "npx tsx scripts/topic-monetization.ts",
    "topics:monetize:diverse": "npx tsx scripts/topic-monetization.ts 10 --diverse --max-per-niche=2 --min-distinct=3",
    "topics:assets": "npx tsx scripts/topics-to-assets.ts",
    "topics:summary": "npx tsx scripts/daily-summary.ts",
    "batch": "npx tsx scripts/story-batch.ts",
    "demo": "npx tsx scripts/manual-tests/demo.ts",
    "test:all": "npx tsx scripts/manual-tests/test-all.ts",
    "test:image": "npx tsx scripts/manual-tests/test-image.ts",
    "test:tts": "npx tsx scripts/manual-tests/test-tts.ts"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "openai": "^4.56.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
