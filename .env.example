# Runtime config for story / full / daily flows
LLM_API_KEY=your_llm_api_key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5.4

# Optional OpenAI-compatible aliases
# OPENAI_API_KEY=your_openai_api_key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-5.4
# OPENAI_WIRE_API=responses
# base_url=https://api.openai.com
# wire_api=responses

# Image generation (required when generating images)
HF_API_KEY=your_huggingface_api_key

# Optional VoiceRSS provider
# VOICERSS_API_KEY=your_voicerss_api_key

# Optional notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Optional runtime knobs
# DRY_RUN=false
# OUTPUT_DIR=
# REQUEST_TIMEOUT_MS=45000
# MAX_RETRIES=3
# RETRY_BASE_DELAY_MS=1500
